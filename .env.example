# AccessGuard AI Environment Configuration
# Copy this file to .env and adjust values for your local environment.
# Never commit .env or secrets to Git.

APP_ENV=development
APP_NAME=AccessGuard AI
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5173

# Database configuration
# Inside Docker Compose use postgres:5432; on host use localhost:5432
DATABASE_URL=postgresql+psycopg://accessguard:change-me@postgres:5432/accessguard

# Redis broker and cache
# Inside Docker Compose use redis:6379; on host use localhost:6379
REDIS_URL=redis://redis:6379/0

# Qdrant vector database
# Inside Docker Compose use qdrant:6333; on host use localhost:6333
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=wcag_knowledge

# Authentication & Session Security
JWT_SECRET_KEY=replace-with-a-random-local-secret
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# LLM Provider Configuration
# Set to 'mock' for Phases 1-9 without requiring external keys.
# In Phase 10, set to 'gemini' or 'groq' with appropriate key and model ID.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=
GROQ_MODEL=

# Local Retrieval Models (No API keys needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_ENABLED=false

# Scanner Limits and Timeouts (Server Hard Bounds)
MAX_SCAN_PAGES=20
MAX_CRAWL_DEPTH=2
PAGE_TIMEOUT_SECONDS=25
SCAN_TOTAL_TIMEOUT_SECONDS=300
MAX_RESPONSE_BYTES=5000000
MAX_HTML_EVIDENCE_CHARS=12000
ARTIFACT_STORAGE_DIR=/app/storage
AXE_BUNDLE_PATH=/app/tools/axe/node_modules/axe-core/axe.min.js
TEST_ALLOW_LOOPBACK=false
LOG_LEVEL=INFO
